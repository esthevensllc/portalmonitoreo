			ROUND(KPI_CHURN, 2) KPI_CHURN,
			CASE WHEN NVL(KPI_SCORE_DEN, 0) = 0 THEN 0 ELSE ROUND(KPI_SCORE_NUM/KPI_SCORE_DEN, 2)*100 END KPI_SCORE_DEN,
			ROUND(CASE WHEN KPI_CLIENTE_TOTAL = 0 OR KPI_CLIENTE_TOTAL IS NULL THEN 0 ELSE NVL(KPI_CLIENTES_SUSPENDIDOS, 0)/KPI_CLIENTE_TOTAL END, 2)*100 KPI_PORCENTAJE_SUSPENDIDOS,
			kpi_clientes_nuevos_2m,
			kpi_clientes_bajas_2m,
			kpi_mejor_operador,
			kpi_mejor_latencia,
			kpi_latencia_ms,
			null RUC10,
			null RUC20
		FROM FIJA_PLANOS_KPIS a
		LEFT JOIN (SELECT PLANO PLANO_, CLIENTES_BAJAS, CLIENTES_NUEVOS FROM TEST_FIJA_ACUM_KPI) c
