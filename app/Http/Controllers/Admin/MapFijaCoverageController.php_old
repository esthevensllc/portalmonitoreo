			'3' => [],
			'4' => [
				"anio" => "a.anio",
				"semana" => "a.semana",
				"plano" => "a.plano",
			],
		];

		$this->query_cob_otros_by_distribucion = [
            '1' => "SELECT PSO.UBIGEO_DPTO, PSO.DEPARTAMENTO
				FROM ( {$this->query_by_distribucion['1']} ) PSO
