	private $tableByDistribucion;

    public function __construct(PsoModuleRepository $repository)
    {
        $this->configRepository = $repository;

		$this->query_by_distribucion = [
            '1' => "SELECT ANIO, SEMANA, DEPARTAMENTO,
				RESULTTIME, UBIGEO_DPTO,
				ROUND(NVL(CASE WHEN KPI_HHPP_TOTALES = 0 THEN 0 ELSE KPI_CLIENTE_TOTAL/KPI_HHPP_TOTALES END, 0), 4)*100 KPI_OCUPACION,
				KPI_CLIENTES_SUSPENDIDOS, KPI_CLIENTE_TOTAL, KPI_CANT_AUTOSATURADOS,
				KPI_VELOCIDAD_MAXIMA, KPI_HHPP_TOTALES, KPI_CLIENTES_NUEVOS, KPI_CLIENTES_BAJAS,
				ROUND(KPI_NUM_VELOCIDAD_MBPS/KPI_DEN_VELOCIDAD_MBPS, 2) KPI_VELOCIDAD_MBPS_AVG,
				(
					select
						round(100*(case when avg(nvl(kpi_cliente_total,0)) >0 then avg(nvl(kpi_clientes_bajas,0))/avg(nvl(kpi_cliente_total,0)) else 0 end),2) kpi_churn
					from   (
						select anio, semana,
							ubigeo_dpto,
							sum(nvl(kpi_clientes_bajas,0)) kpi_clientes_bajas,
							sum(nvl(kpi_cliente_total,0)) kpi_cliente_total
						from   fija_planos_kpis
						where
                        anio <= kpi.anio and semana <= kpi.semana
                        --anio <= 2022 and semana <= 36
                        and ubigeo_dpto = kpi.ubigeo_dpto
                        --and ubigeo_dpto = '04'
						group by anio, semana, ubigeo_dpto
                        order by anio desc, semana desc
                        fetch first 4 rows only
					) group by ubigeo_dpto
				) kpi_churn,
				CASE WHEN KPI_SCORE_DEN = 0 THEN 0 ELSE ROUND(KPI_SCORE_NUM/KPI_SCORE_DEN, 2)*100 END KPI_SCORE_DEN,
				ROUND(CASE WHEN KPI_CLIENTE_TOTAL = 0 OR KPI_CLIENTE_TOTAL IS NULL THEN 0 ELSE NVL(KPI_CLIENTES_SUSPENDIDOS, 0)/KPI_CLIENTE_TOTAL END, 2)*100 KPI_PORCENTAJE_SUSPENDIDOS
				FROM
				(
					SELECT ANIO, SEMANA, DEPARTAMENTO,
					MAX(TO_CHAR(FEC_FIN, 'YYYY-MM-DD HH24:MI:SS')) AS RESULTTIME, MAX(UBIGEO_DPTO) AS UBIGEO_DPTO,
					SUM(KPI_CLIENTES_SUSPENDIDOS) KPI_CLIENTES_SUSPENDIDOS,
					SUM(KPI_CLIENTE_TOTAL) KPI_CLIENTE_TOTAL, SUM(KPI_CANT_AUTOSATURADOS) KPI_CANT_AUTOSATURADOS,
					SUM(KPI_VELOCIDAD_MAXIMA) KPI_VELOCIDAD_MAXIMA, SUM(KPI_HHPP_TOTALES) KPI_HHPP_TOTALES,
					SUM(KPI_CLIENTES_NUEVOS) KPI_CLIENTES_NUEVOS, SUM(KPI_CLIENTES_BAJAS) KPI_CLIENTES_BAJAS,
					SUM(KPI_NUM_VELOCIDAD_MBPS) KPI_NUM_VELOCIDAD_MBPS, SUM(KPI_DEN_VELOCIDAD_MBPS) KPI_DEN_VELOCIDAD_MBPS,
					SUM(NVL(KPI_SCORE_DEN, 0)) KPI_SCORE_DEN,
					SUM(NVL(KPI_SCORE_NUM, 0)) KPI_SCORE_NUM
					FROM FIJA_PLANOS_KPIS [str_filters]
					GROUP BY ANIO, SEMANA, DEPARTAMENTO
				) kpi",
            '2' => "SELECT ANIO, SEMANA, DEPARTAMENTO, PROVINCIA,
				RESULTTIME, UBIGEO_PROV,
				ROUND(NVL(CASE WHEN KPI_HHPP_TOTALES = 0 THEN 0 ELSE KPI_CLIENTE_TOTAL/KPI_HHPP_TOTALES END, 0), 4)*100 KPI_OCUPACION,
				KPI_CLIENTES_SUSPENDIDOS, KPI_CLIENTE_TOTAL, KPI_CANT_AUTOSATURADOS,
				KPI_VELOCIDAD_MAXIMA, KPI_HHPP_TOTALES, KPI_CLIENTES_NUEVOS, KPI_CLIENTES_BAJAS,
				ROUND(KPI_NUM_VELOCIDAD_MBPS/KPI_DEN_VELOCIDAD_MBPS, 2) KPI_VELOCIDAD_MBPS_AVG,
				(
					select
						round(100*(case when avg(nvl(kpi_cliente_total,0)) >0 then avg(nvl(kpi_clientes_bajas,0))/avg(nvl(kpi_cliente_total,0)) else 0 end),2) kpi_churn
					from   (
						select anio, semana,
							ubigeo_prov,
							sum(nvl(kpi_clientes_bajas,0)) kpi_clientes_bajas,
							sum(nvl(kpi_cliente_total,0)) kpi_cliente_total
						from   fija_planos_kpis
						where
                        anio <= kpi.anio and semana <= kpi.semana
                        and ubigeo_prov = kpi.ubigeo_prov
						group by anio, semana, ubigeo_prov
                        order by anio desc, semana desc
                        fetch first 4 rows only
					) group by ubigeo_prov
				) kpi_churn,
				CASE WHEN KPI_SCORE_DEN = 0 THEN 0 ELSE ROUND(KPI_SCORE_NUM/KPI_SCORE_DEN, 2)*100 END KPI_SCORE_DEN,
				ROUND(CASE WHEN KPI_CLIENTE_TOTAL = 0 OR KPI_CLIENTE_TOTAL IS NULL THEN 0 ELSE NVL(KPI_CLIENTES_SUSPENDIDOS, 0)/KPI_CLIENTE_TOTAL END, 2)*100 KPI_PORCENTAJE_SUSPENDIDOS
				FROM
				(
					SELECT ANIO, SEMANA, DEPARTAMENTO, PROVINCIA,
					MAX(TO_CHAR(FEC_FIN, 'YYYY-MM-DD HH24:MI:SS')) AS RESULTTIME, MAX(UBIGEO_PROV) AS UBIGEO_PROV,
					SUM(KPI_CLIENTES_SUSPENDIDOS) KPI_CLIENTES_SUSPENDIDOS,
					SUM(KPI_CLIENTE_TOTAL) KPI_CLIENTE_TOTAL, SUM(KPI_CANT_AUTOSATURADOS) KPI_CANT_AUTOSATURADOS,
					SUM(KPI_VELOCIDAD_MAXIMA) KPI_VELOCIDAD_MAXIMA, SUM(KPI_HHPP_TOTALES) KPI_HHPP_TOTALES,
					SUM(KPI_CLIENTES_NUEVOS) KPI_CLIENTES_NUEVOS, SUM(KPI_CLIENTES_BAJAS) KPI_CLIENTES_BAJAS,
					SUM(KPI_NUM_VELOCIDAD_MBPS) KPI_NUM_VELOCIDAD_MBPS, SUM(KPI_DEN_VELOCIDAD_MBPS) KPI_DEN_VELOCIDAD_MBPS,
					SUM(NVL(KPI_SCORE_DEN, 0)) KPI_SCORE_DEN,
					SUM(NVL(KPI_SCORE_NUM, 0)) KPI_SCORE_NUM
					FROM FIJA_PLANOS_KPIS [str_filters]
					GROUP BY ANIO, SEMANA, DEPARTAMENTO, PROVINCIA
				) kpi",
            '3' => "SELECT ANIO, SEMANA, DEPARTAMENTO, PROVINCIA, DISTRITO,
				RESULTTIME, UBIGEO,
				ROUND(NVL(CASE WHEN KPI_HHPP_TOTALES = 0 THEN 0 ELSE KPI_CLIENTE_TOTAL/KPI_HHPP_TOTALES END, 0), 4)*100 KPI_OCUPACION,
				KPI_CLIENTES_SUSPENDIDOS, KPI_CLIENTE_TOTAL, KPI_CANT_AUTOSATURADOS,
				KPI_VELOCIDAD_MAXIMA, KPI_HHPP_TOTALES, KPI_CLIENTES_NUEVOS, KPI_CLIENTES_BAJAS,
				ROUND(KPI_NUM_VELOCIDAD_MBPS/KPI_DEN_VELOCIDAD_MBPS, 2) KPI_VELOCIDAD_MBPS_AVG,
				(
					select
						round(100*(case when avg(nvl(kpi_cliente_total,0)) >0 then avg(nvl(kpi_clientes_bajas,0))/avg(nvl(kpi_cliente_total,0)) else 0 end),2) kpi_churn
					from   (
						select anio, semana,
							ubigeo,
							sum(nvl(kpi_clientes_bajas,0)) kpi_clientes_bajas,
							sum(nvl(kpi_cliente_total,0)) kpi_cliente_total
						from   fija_planos_kpis
						where
                        anio <= kpi.anio and semana <= kpi.semana
                        and ubigeo = kpi.ubigeo
						group by anio, semana, ubigeo
                        order by anio desc, semana desc
                        fetch first 4 rows only
					) group by ubigeo
				) kpi_churn,
				CASE WHEN KPI_SCORE_DEN = 0 THEN 0 ELSE ROUND(KPI_SCORE_NUM/KPI_SCORE_DEN, 2)*100 END KPI_SCORE_DEN,
				ROUND(CASE WHEN KPI_CLIENTE_TOTAL = 0 OR KPI_CLIENTE_TOTAL IS NULL THEN 0 ELSE NVL(KPI_CLIENTES_SUSPENDIDOS, 0)/KPI_CLIENTE_TOTAL END, 2)*100 KPI_PORCENTAJE_SUSPENDIDOS
				FROM
				(
					SELECT ANIO, SEMANA, DEPARTAMENTO, PROVINCIA, DISTRITO,
					MAX(TO_CHAR(FEC_FIN, 'YYYY-MM-DD HH24:MI:SS')) AS RESULTTIME, MAX(substr(UBIGEO, 1, 6)) AS UBIGEO,
					SUM(KPI_CLIENTES_SUSPENDIDOS) KPI_CLIENTES_SUSPENDIDOS,
					SUM(KPI_CLIENTE_TOTAL) KPI_CLIENTE_TOTAL, SUM(KPI_CANT_AUTOSATURADOS) KPI_CANT_AUTOSATURADOS,
					SUM(KPI_VELOCIDAD_MAXIMA) KPI_VELOCIDAD_MAXIMA, SUM(KPI_HHPP_TOTALES) KPI_HHPP_TOTALES,
					SUM(KPI_CLIENTES_NUEVOS) KPI_CLIENTES_NUEVOS, SUM(KPI_CLIENTES_BAJAS) KPI_CLIENTES_BAJAS,
					SUM(KPI_NUM_VELOCIDAD_MBPS) KPI_NUM_VELOCIDAD_MBPS, SUM(KPI_DEN_VELOCIDAD_MBPS) KPI_DEN_VELOCIDAD_MBPS,
					SUM(NVL(KPI_SCORE_DEN, 0)) KPI_SCORE_DEN,
					SUM(NVL(KPI_SCORE_NUM, 0)) KPI_SCORE_NUM
					FROM FIJA_PLANOS_KPIS [str_filters]
					GROUP BY ANIO, SEMANA, DEPARTAMENTO, PROVINCIA, DISTRITO
				) kpi",
            '4' => "SELECT a.ANIO, a.SEMANA, TO_CHAR(FEC_FIN, 'YYYY-MM-DD HH24:MI:SS') AS RESULTTIME,
				a.PLANO, REGION, DEPARTAMENTO, PROVINCIA, DISTRITO, UBIGEO, TECNOLOGIA, TO_CHAR(FECHA_LIBERACION, 'DD/MM/YYYY') AS FECHA_LIBERACION, COMPETENCIA, NUM_COMPETENCIA, NUM_INTERACCIONES, CASE WHEN ROUND(TRUNC(SYSDATE, 'DD') - FECHA_LIBERACION, 0) <= 60 THEN 1 ELSE NULL END FLAG_NEW,
				ROUND(NVL(CASE WHEN KPI_HHPP_TOTALES IS NULL THEN 0 ELSE KPI_CLIENTE_TOTAL / KPI_HHPP_TOTALES END, 0)*100, 2) AS KPI_OCUPACION,
				KPI_CLIENTES_SUSPENDIDOS, KPI_CLIENTE_TOTAL, KPI_CANT_AUTOSATURADOS, KPI_VELOCIDAD_MAXIMA, KPI_HHPP_TOTALES,
				KPI_CLIENTES_NUEVOS, KPI_CLIENTES_BAJAS,
				--ROUND(KPI_VELOCIDAD_MBPS_AVG, 2) KPI_VELOCIDAD_MBPS_AVG
				ROUND(KPI_NUM_VELOCIDAD_MBPS/KPI_DEN_VELOCIDAD_MBPS, 2) KPI_VELOCIDAD_MBPS_AVG,
				ROUND(KPI_CHURN, 2) KPI_CHURN,
				CASE WHEN NVL(KPI_SCORE_DEN, 0) = 0 THEN 0 ELSE ROUND(KPI_SCORE_NUM/KPI_SCORE_DEN, 2)*100 END KPI_SCORE_DEN,
				ROUND(CASE WHEN KPI_CLIENTE_TOTAL = 0 OR KPI_CLIENTE_TOTAL IS NULL THEN 0 ELSE NVL(KPI_CLIENTES_SUSPENDIDOS, 0)/KPI_CLIENTE_TOTAL END, 2)*100 KPI_PORCENTAJE_SUSPENDIDOS,
				kpi_clientes_nuevos_2m,
				kpi_clientes_bajas_2m,
				kpi_mejor_operador,
				kpi_mejor_latencia,
				kpi_latencia_ms,
				(select count(*) from GIS_EMP_RUC_20_10 where tipo_ruc='RUC 10 CON NEGOCIO' and (gis_nombre_ftth = a.plano or gis_nombre_hfc = a.plano)) RUC10,
				(select count(*) from GIS_EMP_RUC_20_10 where tipo_ruc='RUC 20' and (gis_nombre_ftth = a.plano or gis_nombre_hfc = a.plano)) RUC20
			FROM FIJA_PLANOS_KPIS a
			LEFT JOIN (SELECT anio, semana, plano, NUM_INTERACCIONES FROM FIJA_RES_PLANOS_SEM) b
			ON b.anio = a.anio and b.semana = a.semana and b.plano = a.plano
			[str_filters]",
        ];

		$this->query_by_distribucion_2 = $this->query_by_distribucion;
		$this->query_by_distribucion_2['4'] = "SELECT a.ANIO, a.SEMANA, TO_CHAR(FEC_FIN, 'YYYY-MM-DD HH24:MI:SS') AS RESULTTIME,
			a.PLANO, REGION, DEPARTAMENTO, PROVINCIA, DISTRITO, UBIGEO, TECNOLOGIA, TO_CHAR(FECHA_LIBERACION, 'DD/MM/YYYY') AS FECHA_LIBERACION,
			COMPETENCIA, NUM_COMPETENCIA, NUM_INTERACCIONES,
			CASE WHEN ROUND(TRUNC(SYSDATE, 'DD') - FECHA_LIBERACION, 0) <= 30*6 THEN 1 ELSE NULL END FLAG_NEW,
			ROUND(NVL(CASE WHEN KPI_HHPP_TOTALES IS NULL THEN 0 ELSE KPI_CLIENTE_TOTAL / KPI_HHPP_TOTALES END, 0)*100, 2) AS KPI_OCUPACION,
			KPI_CLIENTES_SUSPENDIDOS, KPI_CLIENTE_TOTAL, KPI_CANT_AUTOSATURADOS, KPI_VELOCIDAD_MAXIMA, KPI_HHPP_TOTALES,
			NVL(C.CLIENTES_NUEVOS, KPI_CLIENTES_NUEVOS) KPI_CLIENTES_NUEVOS,
